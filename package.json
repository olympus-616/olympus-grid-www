{
  "name": "olympus-grid-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postbuild": "react-snap"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "react-helmet-async": "^2.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.0",
    "react-snap": "^1.23.0"
  },
  "reactSnap": {
    "source": "dist",
    "minifyHtml": { "collapseWhitespace": true },
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "include": ["/", "/security", "/privacy", "/terms", "/references", "/about"]
  }
}
